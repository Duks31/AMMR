    </link>

    <joint name="left_front_wheel_1_joint" type="continuous">
        <origin xyz="0.18868 0.18151 0.0962" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="left_front_wheel_1" />
        <axis xyz="0.0 1.0 0.0" />
    </joint>
    <joint name="left_back_wheel_1_joint" type="continuous">
        <origin xyz="-0.18868 0.18151 0.0962" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="left_back_wheel_1" />
        <axis xyz="0.0 1.0 0.0" />
    </joint>
    <joint name="right_front_wheel_1_joint" type="continuous">
        <origin xyz="0.18868 -0.18151 0.0962" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="right_front_wheel_1" />
        <axis xyz="-0.0 1.0 0.0" />
    </joint>
    <joint name="right_back_wheel_1_joint" type="continuous">
        <origin xyz="-0.18868 -0.18151 0.0962" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="right_back_wheel_1" />
        <axis xyz="0.0 1.0 0.0" />
    </joint>

    <joint name="lidar_1_joint" type="fixed">
        <origin xyz="0.250676 0.115003 0.193866" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="lidar_1" />
    </joint>

    <joint name="OAKDCamera_1_joint" type="fixed">
        <origin xyz="-0.229034 0.0 0.657116" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="OAKDcamera_1" />
    </joint>

    <joint name="arm_bottom_1_joint" type="fixed">
        <origin xyz="0.218704 0.0 0.149616" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="arm_bottom_1" />
    </joint>

    <joint name="turntable_1_joint" type="continuous">
        <origin xyz="-0.055 0.0 0.079555" rpy="0 0 0" />
        <parent link="arm_bottom_1" />
        <child link="turntable_1" />
        <axis xyz="0.0 -0.0 1.0" />
    </joint>

    <joint name="lower_arm_1_joint" type="revolute">
        <origin xyz="0.00025 -0.0318 0.0655" rpy="0 0 0" />
        <parent link="turntable_1" />
        <child link="lower_arm_1" />
        <axis xyz="-0.0 1.0 0.0" />
        <limit upper="3.142" lower="-0.1" effort="100" velocity="100" />
    </joint>

    <joint name="center_arm_1_joint" type="revolute">
        <origin xyz="-0.183288 0.0555 -0.025108" rpy="0 0 0" />
        <parent link="lower_arm_1" />
        <child link="center_arm_1" />
        <axis xyz="0.0 -1.0 -0.0" />
        <limit upper="3.14159" lower="0" effort="100" velocity="100" />
    </joint>

    <joint name="upper_arm_1_joint" type="revolute">
        <origin xyz="-0.045533 0.0065 0.108319" rpy="0 0 0" />
        <parent link="center_arm_1" />
        <child link="upper_arm_1" />
        <axis xyz="-0.0 1.0 0.0" />
        <limit upper="0" lower="-3.142" effort="100" velocity="100" />
    </joint>

    <joint name="gripper_mount_1_joint" type="revolute">
        <origin xyz="0.081028 -0.02995 -0.004201" rpy="0 0 0" />
        <parent link="upper_arm_1" />
        <child link="gripper_mount_1" />
        <axis xyz="0.956814 -0.0 -0.290702" />
        <limit upper="3.142" lower="0" effort="100" velocity="100" />
    </joint>

    <joint name="left_gripper_1_joint" type="revolute">
        <origin xyz="0.072478 0.0 -0.022021" rpy="0 0 0" />
        <parent link="gripper_mount_1" />
        <child link="left_gripper_1" />
        <axis xyz="-0.290702 0.0 -0.956814" />
        <limit upper="0.0" lower="-0.785398" effort="100" velocity="100" />
    </joint>

    <joint name="right_gripper_1_joint" type="revolute">
        <origin xyz="0.072478 0.0 -0.022021" rpy="0 0 0" />
        <parent link="gripper_mount_1" />
        <child link="right_gripper_1" />
        <axis xyz="-0.290702 0.0 -0.956814" />
        <limit upper="0.785398" lower="0.0" effort="100" velocity="100" />
        <mimic joint="left_gripper_1_joint" multiplier="-1.0" />
    </joint>

    <joint name="oakd_optical_joint" type="fixed">
        <parent link="OAKDcamera_1" />
        <child link="OAKDcamera_1_optical" />
        <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
    </joint>

    <ros2_control name="CikaSystem" type="system">
        <hardware>
            <xacro:if value="$(arg use_sim)">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>
            <xacro:unless value="$(arg use_sim)">
                <plugin>cika_hardware/CikaDriveInterface</plugin>
                <param name="wheel_separation">0.363</param>
                <param name="wheel_radius">0.0885</param>
                <param name="odom_topic">/cika/odom</param>
                <param name="cmd_topic">/cika/drive/wheel_vel_cmd</param>
            </xacro:unless>
        </hardware>

        <joint name="left_front_wheel_1_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="left_back_wheel_1_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="right_front_wheel_1_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="right_back_wheel_1_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </ros2_control>

    <ros2_control name="CikaArmSystem" type="system">
        <hardware>
            <xacro:if value="$(arg use_sim)">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>
            <xacro:unless value="$(arg use_sim)">
                <plugin>cika_hardware_arm/CikaHardware</plugin>
                <param name="serial_port">/dev/ttyUSB0</param>
                <param name="baud_rate">115200</param>
            </xacro:unless>
        </hardware>

        <joint name="turntable_1_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="lower_arm_1_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="center_arm_1_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="upper_arm_1_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="gripper_mount_1_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="left_gripper_1_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </ros2_control>
</robot>